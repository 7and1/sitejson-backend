{
  "name": "sitejson-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:export": "tsx scripts/openapi-export.ts",
    "openapi:check": "tsx scripts/openapi-check.ts",
    "audit:deps": "npm audit --audit-level=moderate",
    "cleanup:legacy-report-fields": "tsx src/cli/cleanup-legacy-report-fields.ts",
    "backfill:directory-fields": "tsx src/cli/backfill-directory-derived-fields.ts",
    "enqueue:high-value-browser-refresh": "tsx src/cli/enqueue-high-value-browser-refresh.ts",
    "queue:browser-backlog": "node dist/cli/browser-queue-maintenance.js",
    "queue:browser-first-run": "node dist/cli/enqueue-browser-first-run.js",
    "queue:feed-repeatables": "node dist/cli/manage-ingest-repeatables.js",
    "queue:release-stale-pending": "node dist/cli/release-stale-browser-pending.js",
    "retention:cleanup": "node dist/cli/retention-cleanup.js",
    "ops:12h-status": "node dist/cli/sitejson-12h-status.js",
    "ops:12h-watch": "node dist/cli/sitejson-12h-status.js --watch --duration-hours=1 --interval-seconds=300 --fail-on-warnings",
    "backfill:domain-age": "tsx src/cli/backfill-domain-age.ts",
    "backfill:whois-rdap": "tsx src/cli/backfill-whois-rdap.ts",
    "backfill:alternatives-cache": "tsx src/cli/backfill-alternatives-cache.ts",
    "traffic:enqueue-missing": "tsx src/cli/enqueue-traffic-missing.ts",
    "whois:enqueue-missing": "tsx src/cli/enqueue-whois-missing.ts",
    "db:explain-due-batch": "tsx src/cli/explain-due-batch.ts",
    "security:scan": "node scripts/security-scan.mjs --scope backend"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1037.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "bullmq": "^5.76.2",
    "fastify": "^5.8.5",
    "ioredis": "5.10.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "playwright": "^1.55.1",
    "pngjs": "^7.0.0",
    "sharp": "0.34.5",
    "tldts": "^6.1.71",
    "undici": "^7.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "yaml": "2.8.3"
  }
}
